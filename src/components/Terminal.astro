---
import { profile } from '../data/profile.js';
---

<section class="terminal-section" id="terminal-section">
  <div class="container">
    <h2 class="section-title">Interactive Terminal.</h2>
    <p class="section-subtitle">
      Prefer a command line? Query my background, tech stack, and systems directly from this shell.
    </p>

    <!-- Terminal Window Container -->
    <div class="terminal-window glass-card" id="terminal-window">
      <!-- Window Header Bar -->
      <div class="terminal-header">
        <div class="window-controls">
          <span class="control-dot dot-red"></span>
          <span class="control-dot dot-yellow"></span>
          <span class="control-dot dot-green"></span>
        </div>
        <div class="terminal-title">dipanshu@systems-node:~ (zsh)</div>
        <div class="terminal-status">ONLINE</div>
      </div>

      <!-- Terminal Body -->
      <div class="terminal-body" id="terminal-body">
        <div class="terminal-output" id="terminal-output">
          <div class="terminal-banner">
            <div class="banner-title">DIPANSHU.DEV | SYSTEMS SHELL [v2.4.0]</div>
            <p class="welcome-text">
              Type <span class="cmd-highlight">'help'</span> to inspect available commands.
            </p>
          </div>
        </div>

        <!-- Terminal Input Prompt -->
        <form class="terminal-input-row" id="terminal-form" autocomplete="off">
          <span class="terminal-prompt">dipanshu@portfolio:~$</span>
          <input 
            type="text" 
            id="terminal-input" 
            class="terminal-input" 
            aria-label="Terminal command input" 
            spellcheck="false" 
            autocapitalize="off" 
            autocomplete="off" 
          />
        </form>
      </div>
    </div>
  </div>
</section>

<!-- Client-side terminal engine -->
<script is:inline>
  (function initTerminal() {
    const input = document.getElementById('terminal-input');
    const form = document.getElementById('terminal-form');
    const output = document.getElementById('terminal-output');
    const terminalBody = document.getElementById('terminal-body');
    const terminalWindow = document.getElementById('terminal-window');

    if (!input || !form || !output) return;

    // Focus input on click anywhere in terminal
    if (terminalWindow) {
      terminalWindow.addEventListener('click', () => {
        input.focus();
      });
    }

    const commandHistory = [];
    let historyIndex = -1;

    const COMMANDS = {
      help: () => `
<div class="term-response">
  <div class="term-row"><span class="term-cmd">help</span> - Display list of available commands</div>
  <div class="term-row"><span class="term-cmd">about</span> - Background, education at NIT Delhi, and focus</div>
  <div class="term-row"><span class="term-cmd">skills</span> - Languages, frameworks, databases, and DevOps tools</div>
  <div class="term-row"><span class="term-cmd">projects</span> - Inspect CodeRecall, TaskFlow, and PulseAPI</div>
  <div class="term-row"><span class="term-cmd">achievements</span> - HackOn S5, 700+ DSA problems, and rankings</div>
  <div class="term-row"><span class="term-cmd">contact</span> - Direct email, GitHub, and professional links</div>
  <div class="term-row"><span class="term-cmd">resume</span> - Academic history and credentials summary</div>
  <div class="term-row"><span class="term-cmd">tesseract</span> - Mathematics of the 4D wireframe hero animation</div>
  <div class="term-row"><span class="term-cmd">clear</span> - Clear current terminal screen</div>
</div>`,

      about: () => `
<div class="term-response">
  <p><strong>Dipanshu Sahoo</strong> - B.Tech in Electronics and Communication Engineering at <strong>National Institute of Technology Delhi (NIT Delhi)</strong> [2023 - 2027].</p>
  <p style="margin-top: 6px; color: #94a3b8;">Software Engineer specializing in scalable full-stack web applications, rate-limited backend architectures, and developer tooling with Next.js, Express, PostgreSQL, and Redis.</p>
</div>`,

      skills: () => `
<div class="term-response">
  <div class="term-row"><span class="term-header">Languages:</span> C, C++, JavaScript, TypeScript, Python, HTML/CSS, SQL</div>
  <div class="term-row"><span class="term-header">Frameworks:</span> Next.js 14, React.js, Node.js, Express.js, Tailwind CSS, Prisma ORM</div>
  <div class="term-row"><span class="term-header">Databases & Tools:</span> PostgreSQL, MongoDB, Redis, Docker, Kubernetes, AWS, Git, Postman</div>
  <div class="term-row"><span class="term-header">Core Subjects:</span> DSA, OOP, OS, DBMS, Computer Networks</div>
</div>`,

      projects: () => `
<div class="term-response">
  <div class="term-row">
    <strong style="color: #38bdf8;">1. CodeRecall</strong> (Next.js 14, TypeScript, PostgreSQL, Prisma, Upstash Redis, Monaco Editor)<br />
    <span style="color: #94a3b8;">Spaced-repetition platform for LeetCode revision using SuperMemo SM-2 algorithm. 10 req/s rate limits & &lt;50ms response times.</span><br />
    <a href="https://code-recall-nu.vercel.app" target="_blank" style="color: #38bdf8; text-decoration: underline;">Live Demo: code-recall-nu.vercel.app</a>
  </div>
  <div class="term-row" style="margin-top: 8px;">
    <strong style="color: #38bdf8;">2. TaskFlow</strong> (Node.js, Express.js, MongoDB, JWT, Docker, Swagger)<br />
    <span style="color: #94a3b8;">Project management backend with hierarchical RBAC, JWT refresh tokens, cookie sessions, and GitHub Actions CI.</span>
  </div>
  <div class="term-row" style="margin-top: 8px;">
    <strong style="color: #38bdf8;">3. PulseAPI</strong> (Next.js, JavaScript, PostgreSQL, Prisma, Better Auth)<br />
    <span style="color: #94a3b8;">Developer API testing client with request collections, workspaces, cURL import/export, and automated test assertions.</span>
  </div>
</div>`,

      achievements: () => `
<div class="term-response">
  <div class="term-row">🏆 <strong>Amazon HackOn (Season 5):</strong> Advanced to Round 2.</div>
  <div class="term-row">⚡ <strong>Competitive Programming:</strong> 700+ problems solved across LeetCode, Codeforces, GFG, CodeChef.</div>
  <div class="term-row">📐 <strong>PRMO / IOQM:</strong> Qualified Pre-Regional Mathematics Olympiad (Indian Olympiad Qualifier in Mathematics).</div>
  <div class="term-row">⚽ <strong>Inter-NIT Sports:</strong> Represented NIT Delhi in All India Inter-NIT Football Competition.</div>
</div>`,

      contact: () => `
<div class="term-response">
  <div class="term-row">Email: <a href="mailto:dipanshu.sahoo.18@gmail.com" style="color: #38bdf8; text-decoration: underline;">dipanshu.sahoo.18@gmail.com</a></div>
  <div class="term-row">GitHub: <a href="https://github.com/Ashtaroth91" target="_blank" style="color: #38bdf8; text-decoration: underline;">github.com/Ashtaroth91</a></div>
  <div class="term-row">LinkedIn: <a href="https://www.linkedin.com/in/dipanshu-sahoo-7a10a5292/" target="_blank" style="color: #38bdf8; text-decoration: underline;">linkedin.com/in/Dipanshu</a></div>
</div>`,

      resume: () => `
<div class="term-response">
  <p><strong>Education Summary:</strong></p>
  <p style="color: #cbd5e1; margin-top: 4px;">• <strong>NIT Delhi</strong> — B.Tech in Electronics & Communication [2023 - Present] (CGPA: 7.93)</p>
  <p style="color: #cbd5e1; margin-top: 4px;">• <strong>Sahoday Senior Secondary School</strong> — Class 12th (89.6%) | Class 10th (92.4%)</p>
</div>`,

      tesseract: () => `
<div class="term-response">
  <p style="color: #38bdf8;"><strong>4D Hypercube (Tesseract) Mathematics:</strong></p>
  <p style="color: #94a3b8; margin-top: 4px;">A tesseract has 16 vertices (±1, ±1, ±1, ±1) and 32 edges in 4-dimensional Euclidean space ℝ⁴.</p>
  <p style="color: #94a3b8; margin-top: 4px;">The hero canvas continuously rotates these coordinates across the XW, YW, and ZW planes using 4D rotation matrices, projects them down to ℝ³ via perspective divide [1 / (d - w)], then down to ℝ² screen space with depth-based luminance.</p>
</div>`,

      date: () => `
<div class="term-response" style="color: #94a3b8;">
  ${new Date().toString()}
</div>`,

      sudo: () => `
<div class="term-response" style="color: #f87171;">
  Permission denied: User is not in the sudoers file. This incident will be reported to Dipanshu.
</div>`
    };

    form.addEventListener('submit', (e) => {
      e.preventDefault();
      const rawInput = input.value.trim();
      if (!rawInput) return;

      commandHistory.push(rawInput);
      historyIndex = commandHistory.length;

      // Echo input
      const historyLine = document.createElement('div');
      historyLine.className = 'terminal-echo-line';
      historyLine.innerHTML = `<span class="terminal-prompt">dipanshu@portfolio:~$</span> <span class="echo-text">${escapeHtml(rawInput)}</span>`;
      output.appendChild(historyLine);

      const [cmd] = rawInput.toLowerCase().split(' ');

      if (cmd === 'clear') {
        output.innerHTML = '';
      } else if (COMMANDS[cmd]) {
        const resDiv = document.createElement('div');
        resDiv.className = 'command-result';
        resDiv.innerHTML = COMMANDS[cmd]();
        output.appendChild(resDiv);
      } else {
        const errDiv = document.createElement('div');
        errDiv.className = 'command-result error-text';
        errDiv.innerHTML = `command not found: <span style="color: #f87171;">${escapeHtml(rawInput)}</span>. Type <span style="color: #38bdf8;">'help'</span> for a list of commands.`;
        output.appendChild(errDiv);
      }

      input.value = '';
      if (terminalBody) {
        terminalBody.scrollTop = terminalBody.scrollHeight;
      }
    });

    // History navigation with Up and Down arrows
    input.addEventListener('keydown', (e) => {
      if (e.key === 'ArrowUp') {
        e.preventDefault();
        if (historyIndex > 0) {
          historyIndex--;
          input.value = commandHistory[historyIndex];
        }
      } else if (e.key === 'ArrowDown') {
        e.preventDefault();
        if (historyIndex < commandHistory.length - 1) {
          historyIndex++;
          input.value = commandHistory[historyIndex];
        } else {
          historyIndex = commandHistory.length;
          input.value = '';
        }
      } else if (e.key === 'Tab') {
        e.preventDefault();
        const current = input.value.trim().toLowerCase();
        const matches = Object.keys(COMMANDS).filter(k => k.startsWith(current));
        if (matches.length === 1) {
          input.value = matches[0];
        }
      }
    });

    function escapeHtml(text) {
      return text.replace(/&/g, "&amp;").replace(/</g, "&lt;").replace(/>/g, "&gt;");
    }
  })();
</script>

<style>
  .terminal-section {
    border-top: 1px solid var(--border-subtle);
  }

  .terminal-window {
    margin-top: 3.5rem;
    background: #090c13;
    border: 1px solid rgba(56, 189, 248, 0.2);
    border-radius: var(--radius-md);
    overflow: hidden;
    box-shadow: 0 20px 50px -15px rgba(0, 0, 0, 0.8), var(--shadow-glow);
  }

  /* Header Bar */
  .terminal-header {
    background: #0d121c;
    border-bottom: 1px solid var(--border-subtle);
    padding: 0.75rem 1.25rem;
    display: flex;
    align-items: center;
    justify-content: space-between;
  }

  .window-controls {
    display: flex;
    align-items: center;
    gap: 0.5rem;
  }

  .control-dot {
    width: 12px;
    height: 12px;
    border-radius: 50%;
  }

  .dot-red { background: #ef4444; }
  .dot-yellow { background: #f59e0b; }
  .dot-green { background: #10b981; }

  .terminal-title {
    font-family: var(--font-mono);
    font-size: 0.82rem;
    color: var(--text-muted);
  }

  .terminal-status {
    font-family: var(--font-mono);
    font-size: 0.7rem;
    color: var(--status-emerald);
    background: rgba(16, 185, 129, 0.1);
    border: 1px solid rgba(16, 185, 129, 0.25);
    padding: 0.2rem 0.5rem;
    border-radius: var(--radius-sm);
  }

  /* Body */
  .terminal-body {
    padding: 1.5rem 1.75rem 2rem;
    min-height: 380px;
    max-height: 520px;
    overflow-y: auto;
    font-family: var(--font-mono);
    font-size: 0.9rem;
    cursor: text;
  }

  .banner-title {
    font-family: var(--font-mono);
    font-size: 1rem;
    font-weight: 700;
    color: var(--accent-cyan);
    letter-spacing: 0.05em;
    margin-bottom: 0.5rem;
  }

  .welcome-text {
    color: var(--text-secondary);
    margin-bottom: 1.5rem;
    line-height: 1.6;
  }

  .cmd-highlight {
    color: var(--accent-cyan);
    font-weight: 600;
  }

  /* Input Row */
  .terminal-input-row {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    margin-top: 0.75rem;
  }

  .terminal-prompt {
    color: var(--accent-cyan);
    font-weight: 600;
    white-space: nowrap;
    user-select: none;
  }

  .terminal-input {
    flex: 1;
    background: transparent;
    border: none;
    outline: none;
    font-family: var(--font-mono);
    font-size: 0.9rem;
    color: var(--text-primary);
    caret-color: var(--accent-cyan);
  }

  /* History & Responses */
  .terminal-echo-line {
    margin-top: 0.85rem;
    display: flex;
    align-items: center;
    gap: 0.75rem;
  }

  .echo-text {
    color: #e2e8f0;
  }

  .command-result {
    margin-top: 0.5rem;
    margin-bottom: 0.85rem;
    padding-left: 0.5rem;
    border-left: 2px solid rgba(56, 189, 248, 0.3);
  }

  :global(.term-row) {
    margin-bottom: 0.35rem;
    line-height: 1.6;
    color: #cbd5e1;
  }

  :global(.term-cmd) {
    color: var(--accent-cyan);
    font-weight: 600;
    margin-right: 0.5rem;
  }

  :global(.term-header) {
    color: #94a3b8;
    font-weight: 600;
    margin-right: 0.5rem;
  }

  .error-text {
    color: #cbd5e1;
  }
</style>
