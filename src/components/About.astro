---
import { profile } from '../data/profile.js';
---

<section class="about-section" id="about">
  <div class="container">
    <div class="section-tag">about</div>
    <h2 class="section-title">Building with Purpose.</h2>
    <p class="section-subtitle">
      Development isn't just about making code run — it's about making it resilient, observable, and clean.
    </p>

    <div class="about-grid">
      <!-- Left: Purposeful Narrative -->
      <div class="about-narrative glass-card">
        <p class="narrative-p">
          I am a Computer Science enthusiast and undergraduate at <strong>National Institute of Technology Delhi (NIT Delhi)</strong>, pursuing my B.Tech in Electronics and Communication Engineering (CGPA 7.93).
        </p>
        <p class="narrative-p">
          I believe in writing software that is <strong>simple, structured, and purposeful</strong>. Whether implementing the <strong>SuperMemo SM-2 spaced repetition algorithm</strong> in CodeRecall or designing rate-limited microservices backed by <strong>PostgreSQL and Upstash Redis</strong>, I focus on building systems that solve real problems with measurable speed.
        </p>
        <p class="narrative-p">
          Passionate about <strong>Data Structures & Algorithms (700+ problems solved)</strong>, operating systems, and scalable full-stack web architectures. Always aiming for clean code, robust test coverage, and automated CI/CD deployments.
        </p>

        <div class="narrative-badges">
          <span class="badge">NIT Delhi B.Tech</span>
          <span class="badge">Next.js & TypeScript</span>
          <span class="badge">PostgreSQL & Prisma</span>
          <span class="badge">Docker & CI/CD</span>
          <span class="badge">700+ DSA Solved</span>
        </div>
      </div>

      <!-- Right: Live Dynamic Stats & Achievements Grid -->
      <div class="about-right-col">
        <div class="about-stats-grid">
          {profile.stats.map((stat) => (
            <div class="stat-card glass-card">
              <div class="stat-num-wrap">
                <span class="stat-num">{stat.value}</span>
              </div>
              <div class="stat-label">{stat.label}</div>
              <div class="stat-sub">{stat.sub}</div>
            </div>
          ))}
        </div>

        <!-- Achievements Showcase -->
        <div class="achievements-card glass-card">
          <div class="achievements-header">
            <span class="badge" style="color: var(--status-emerald); border-color: rgba(16, 185, 129, 0.3);">Milestones</span>
            <span class="achievements-title">Key Recognitions</span>
          </div>
          <div class="achievements-list">
            {profile.achievements.map((item) => (
              <div class="achievement-item">
                <div class="achievement-dot"></div>
                <div>
                  <strong class="achievement-heading">{item.title}</strong>
                  <p class="achievement-detail">{item.detail}</p>
                </div>
              </div>
            ))}
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .about-section {
    border-top: 1px solid var(--border-subtle);
  }

  .about-grid {
    display: grid;
    grid-template-columns: 1.25fr 0.95fr;
    gap: 2.5rem;
    margin-top: 3rem;
  }

  @media (max-width: 960px) {
    .about-grid {
      grid-template-columns: 1fr;
    }
  }

  /* Narrative Card */
  .about-narrative {
    padding: 2.5rem;
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
  }

  .narrative-p {
    font-size: 1.05rem;
    line-height: 1.8;
    color: var(--text-secondary);
  }

  .narrative-p strong {
    color: var(--text-primary);
    font-weight: 600;
  }

  .narrative-badges {
    display: flex;
    flex-wrap: wrap;
    gap: 0.6rem;
    margin-top: 0.5rem;
    padding-top: 1rem;
    border-top: 1px solid var(--border-subtle);
  }

  .badge {
    font-family: var(--font-mono);
    font-size: 0.8rem;
    color: var(--accent-cyan);
    background: var(--accent-cyan-dim);
    border: 1px solid rgba(56, 189, 248, 0.2);
    padding: 0.35rem 0.75rem;
    border-radius: var(--radius-sm);
  }

  /* Stats Grid */
  .about-stats-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 1.5rem;
  }

  @media (max-width: 540px) {
    .about-stats-grid {
      grid-template-columns: 1fr;
    }
  }

  .stat-card {
    padding: 2rem 1.75rem;
    display: flex;
    flex-direction: column;
    justify-content: center;
    border-left: 3px solid var(--accent-cyan);
  }

  .stat-num-wrap {
    margin-bottom: 0.5rem;
  }

  .stat-num {
    font-size: 2.75rem;
    font-weight: 700;
    color: var(--text-primary);
    line-height: 1;
    letter-spacing: -0.02em;
    font-family: var(--font-sans);
  }

  .stat-label {
    font-size: 0.95rem;
    font-weight: 600;
    color: var(--text-primary);
    margin-bottom: 0.25rem;
  }

  .about-right-col {
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
  }

  .achievements-card {
    padding: 1.75rem;
    display: flex;
    flex-direction: column;
    gap: 1rem;
    border-top: 2px solid var(--status-emerald);
  }

  .achievements-header {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    padding-bottom: 0.75rem;
    border-bottom: 1px solid var(--border-subtle);
  }

  .achievements-title {
    font-size: 1.05rem;
    font-weight: 700;
    color: var(--text-primary);
  }

  .achievements-list {
    display: flex;
    flex-direction: column;
    gap: 0.85rem;
  }

  .achievement-item {
    display: flex;
    align-items: flex-start;
    gap: 0.75rem;
  }

  .achievement-dot {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: var(--status-emerald);
    margin-top: 8px;
    flex-shrink: 0;
  }

  .achievement-heading {
    font-size: 0.88rem;
    color: var(--text-primary);
    display: block;
  }

  .achievement-detail {
    font-size: 0.8rem;
    color: var(--text-muted);
    line-height: 1.5;
  }
</style>
