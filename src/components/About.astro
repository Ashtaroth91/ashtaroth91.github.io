---
import { profile } from '../data/profile.js';
---

<section class="about-section" id="about">
  <div class="container">
    <h2 class="section-title">Building with Purpose.</h2>
    <p class="section-subtitle">
      Development isn't just about making code run — it's about making it resilient, observable, and clean.
    </p>

    <div class="about-grid">
      <!-- Left: Purposeful Narrative -->
      <div class="about-narrative glass-card">
        <p class="narrative-p">
          I am a Computer Science enthusiast and undergraduate at <strong>National Institute of Technology Delhi (NIT Delhi)</strong>, pursuing my B.Tech in Electronics and Communication Engineering (CGPA 7.93).
        </p>
        <p class="narrative-p">
          I believe in writing software that is <strong>simple, structured, and purposeful</strong>. Whether implementing the <strong>SuperMemo SM-2 spaced repetition algorithm</strong> in CodeRecall or designing rate-limited microservices backed by <strong>PostgreSQL and Upstash Redis</strong>, I focus on building systems that solve real problems with measurable speed.
        </p>
        <p class="narrative-p">
          Passionate about <strong>Data Structures & Algorithms (700+ problems solved)</strong>, operating systems, and scalable full-stack web architectures. Always aiming for clean code, robust test coverage, and automated CI/CD deployments.
        </p>

        <div class="narrative-badges">
          <span class="badge">NIT Delhi B.Tech</span>
          <span class="badge">Next.js & TypeScript</span>
          <span class="badge">PostgreSQL & Prisma</span>
          <span class="badge">Docker & CI/CD</span>
          <span class="badge">700+ DSA Solved</span>
        </div>
      </div>

      <!-- Right: Key Recognitions Showcase -->
      <div class="achievements-card glass-card">
        <div class="achievements-header">
          <span class="badge badge-emerald">Milestones</span>
          <h3 class="achievements-title">Key Recognitions</h3>
        </div>
        <div class="achievements-list">
          {profile.achievements.map((item) => (
            <div class="achievement-item">
              <div class="achievement-dot"></div>
              <div class="achievement-text-wrap">
                <strong class="achievement-heading">{item.title}</strong>
                <p class="achievement-detail">{item.detail}</p>
              </div>
            </div>
          ))}
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .about-section {
    border-top: 1px solid var(--border-subtle);
  }

  .about-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 2rem;
    margin-top: 3rem;
    align-items: stretch;
  }

  @media (max-width: 900px) {
    .about-grid {
      grid-template-columns: 1fr;
    }
  }

  /* Narrative Card */
  .about-narrative {
    padding: 2.25rem;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    gap: 1.25rem;
  }

  .narrative-p {
    font-size: 1.02rem;
    line-height: 1.8;
    color: var(--text-secondary);
  }

  .narrative-p strong {
    color: var(--text-primary);
    font-weight: 600;
  }

  .narrative-badges {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin-top: auto;
    padding-top: 1.25rem;
    border-top: 1px solid var(--border-subtle);
  }

  .badge {
    font-family: var(--font-mono);
    font-size: 0.78rem;
    color: var(--accent-cyan);
    background: var(--accent-cyan-dim);
    border: 1px solid rgba(56, 189, 248, 0.2);
    padding: 0.35rem 0.75rem;
    border-radius: var(--radius-sm);
  }

  .badge-emerald {
    color: var(--status-emerald);
    background: rgba(16, 185, 129, 0.08);
    border-color: rgba(16, 185, 129, 0.3);
  }

  /* Achievements Card */
  .achievements-card {
    padding: 2.25rem;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    border-top: 2px solid var(--status-emerald);
  }

  .achievements-header {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    padding-bottom: 1.25rem;
    border-bottom: 1px solid var(--border-subtle);
    margin-bottom: 1.25rem;
  }

  .achievements-title {
    font-size: 1.25rem;
    font-weight: 700;
    color: var(--text-primary);
  }

  .achievements-list {
    display: flex;
    flex-direction: column;
    gap: 1.2rem;
    flex: 1;
    justify-content: space-around;
  }

  .achievement-item {
    display: flex;
    align-items: flex-start;
    gap: 0.85rem;
  }

  .achievement-dot {
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: var(--status-emerald);
    box-shadow: 0 0 8px rgba(16, 185, 129, 0.5);
    margin-top: 7px;
    flex-shrink: 0;
  }

  .achievement-text-wrap {
    flex: 1;
  }

  .achievement-heading {
    font-size: 0.95rem;
    font-weight: 600;
    color: var(--text-primary);
    display: block;
    margin-bottom: 0.2rem;
  }

  .achievement-detail {
    font-size: 0.85rem;
    color: var(--text-muted);
    line-height: 1.55;
  }
</style>
