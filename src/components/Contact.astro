---
import { profile } from '../data/profile.js';
---

<section class="contact-section" id="contact">
  <div class="container">
    <div class="contact-grid">
      <!-- Left: Purposeful Invitation -->
      <div class="contact-content">
        <h2 class="section-title contact-title">
          Let's build something <br />
          <span class="gradient-text">meaningful</span>.
        </h2>
        
        <p class="section-subtitle contact-desc">
          Got an ambitious project, a complex backend challenge, or an engineering role to fill? 
          Let’s connect and engineer software that actually matters.
        </p>

        <div class="contact-availability">
          <span class="pulse-dot"></span>
          <span>Open for Software Engineering opportunities · 2026</span>
        </div>
      </div>

      <!-- Right: Direct Connect Card (Static Container) -->
      <div class="contact-card">
        <h3 class="card-title">Direct Channels</h3>
        <p class="card-subtitle">Feel free to reach out directly via email or professional networks.</p>

        <div class="channel-list">
          
          <!-- Email Box (Clickable Mailto + Copy Button) -->
          <a href={`mailto:${profile.email}`} class="channel-item channel-link" id="email-box">
            <div class="channel-icon-wrap">
              <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"/>
                <polyline points="22,6 12,13 2,6"/>
              </svg>
            </div>
            <div class="channel-details">
              <div class="channel-label">Email Address</div>
              <span class="channel-value">{profile.email}</span>
            </div>
            <button class="copy-btn" id="copy-email-btn" aria-label="Copy email address" type="button">
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <rect x="9" y="9" width="13" height="13" rx="2" ry="2"></rect>
                <path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"></path>
              </svg>
              <span class="copy-tooltip" id="copy-tooltip">Copy</span>
            </button>
          </a>

          <!-- GitHub Box (Clickable Link) -->
          <a href={profile.github} target="_blank" rel="noopener noreferrer" class="channel-item channel-link">
            <div class="channel-icon-wrap">
              <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <path d="M9 19c-5 1.5-5-2.5-7-3m14 6v-3.87a3.37 3.37 0 0 0-.94-2.61c3.14-.35 6.44-1.54 6.44-7A5.44 5.44 0 0 0 20 4.77 5.07 5.07 0 0 0 19.91 1S18.73.65 16 2.48a13.38 13.38 0 0 0-7 0C6.27.65 5.09 1 5.09 1A5.07 5.07 0 0 0 5 4.77a5.44 5.44 0 0 0-1.5 3.78c0 5.42 3.3 6.61 6.44 7A3.37 3.37 0 0 0 9 18.13V22"/>
              </svg>
            </div>
            <div class="channel-details">
              <div class="channel-label">Source Code</div>
              <span class="channel-value">github.com/{profile.handle}</span>
            </div>
            <div class="channel-arrow" aria-hidden="true">
              <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
                <line x1="7" y1="17" x2="17" y2="7"></line>
                <polyline points="7 7 17 7 17 17"></polyline>
              </svg>
            </div>
          </a>

          <!-- LinkedIn Box (Clickable Link) -->
          <a href={profile.linkedin} target="_blank" rel="noopener noreferrer" class="channel-item channel-link">
            <div class="channel-icon-wrap">
              <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <path d="M16 8a6 6 0 0 1 6 6v7h-4v-7a2 2 0 0 0-2-2 2 2 0 0 0-2 2v7h-4v-7a6 6 0 0 1 6-6z"/>
                <rect x="2" y="9" width="4" height="12"/>
                <circle cx="4" cy="4" r="2"/>
              </svg>
            </div>
            <div class="channel-details">
              <div class="channel-label">Network</div>
              <span class="channel-value">linkedin.com/in/Dipanshu</span>
            </div>
            <div class="channel-arrow" aria-hidden="true">
              <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
                <line x1="7" y1="17" x2="17" y2="7"></line>
                <polyline points="7 7 17 7 17 17"></polyline>
              </svg>
            </div>
          </a>

        </div>

        <a href={`mailto:${profile.email}`} class="btn-primary start-convo-btn">
          <span>Start Conversation</span>
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
            <line x1="22" y1="2" x2="11" y2="13"></line>
            <polygon points="22 2 15 22 11 13 2 9 22 2"></polygon>
          </svg>
        </a>
      </div>
    </div>
  </div>
</section>

<!-- Client JavaScript: Email copy to clipboard -->
<script is:inline>
  (function initCopyEmail() {
    const copyBtn = document.getElementById('copy-email-btn');
    const tooltip = document.getElementById('copy-tooltip');
    const email = 'dipanshu.sahoo.18@gmail.com';

    if (copyBtn && tooltip) {
      copyBtn.addEventListener('click', (e) => {
        e.preventDefault();
        e.stopPropagation(); // Prevents mailto from opening when copying
        navigator.clipboard.writeText(email).then(() => {
          tooltip.textContent = 'Copied!';
          tooltip.classList.add('visible');
          setTimeout(() => {
            tooltip.textContent = 'Copy';
            tooltip.classList.remove('visible');
          }, 2000);
        });
      });
    }
  })();
</script>

<style>
  .contact-section {
    border-top: 1px solid var(--border-subtle);
  }

  .contact-grid {
    display: grid;
    grid-template-columns: 1.15fr 0.95fr;
    gap: 3.5rem;
    align-items: center;
    margin-top: 2rem;
  }

  @media (max-width: 960px) {
    .contact-grid {
      grid-template-columns: 1fr;
      gap: 3rem;
    }
  }

  .contact-title {
    font-size: 3rem;
    line-height: 1.15;
    margin-bottom: 1.25rem;
  }

  @media (max-width: 768px) {
    .contact-title {
      font-size: 2.3rem;
    }
  }

  .contact-desc {
    margin-bottom: 2rem;
    font-size: 1.1rem;
    line-height: 1.75;
  }

  .contact-availability {
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    font-family: var(--font-mono);
    font-size: 0.85rem;
    color: var(--status-emerald);
    background: rgba(16, 185, 129, 0.08);
    border: 1px solid rgba(16, 185, 129, 0.25);
    padding: 0.45rem 1rem;
    border-radius: var(--radius-full);
  }

  /* Static Outer Container - strictly no hover transforms */
  .contact-card {
    background: var(--bg-card);
    border: 1px solid var(--border-card);
    border-radius: var(--radius-md);
    box-shadow: var(--shadow-card);
    backdrop-filter: blur(12px);
    -webkit-backdrop-filter: blur(12px);
    padding: 2.5rem;
    display: flex;
    flex-direction: column;
    cursor: default;
    transform: none !important;
    transition: none !important;
  }

  .contact-card:hover {
    transform: none !important;
    box-shadow: var(--shadow-card) !important;
    border-color: var(--border-card) !important;
    background: var(--bg-card) !important;
  }

  .card-title {
    font-size: 1.35rem;
    font-weight: 700;
    margin-bottom: 0.35rem;
  }

  .card-subtitle {
    font-size: 0.9rem;
    color: var(--text-muted);
    margin-bottom: 2rem;
  }

  .channel-list {
    display: flex;
    flex-direction: column;
    gap: 1rem;
    margin-bottom: 2rem;
  }

  /* Dynamic Clickable Channel Items */
  .channel-item {
    display: flex;
    align-items: center;
    gap: 1rem;
    padding: 1.15rem 1.25rem;
    background: var(--bg-tertiary);
    border: 1px solid var(--border-subtle);
    border-radius: var(--radius-sm);
    position: relative;
    text-decoration: none;
    color: inherit;
    cursor: pointer;
    transition: all var(--transition-normal);
  }

  .channel-item:hover {
    background: rgba(24, 32, 50, 0.95);
    border-color: var(--accent-cyan);
    transform: translateY(-2px);
    box-shadow: 0 6px 22px rgba(56, 189, 248, 0.16);
  }

  .channel-icon-wrap {
    width: 38px;
    height: 38px;
    display: flex;
    align-items: center;
    justify-content: center;
    background: var(--bg-card);
    border: 1px solid var(--border-card);
    border-radius: var(--radius-sm);
    color: var(--accent-cyan);
    transition: all var(--transition-fast);
  }

  .channel-item:hover .channel-icon-wrap {
    background: var(--accent-cyan-dim);
    border-color: var(--accent-cyan);
    box-shadow: 0 0 12px var(--accent-cyan-glow);
  }

  .channel-details {
    flex: 1;
  }

  .channel-label {
    font-family: var(--font-mono);
    font-size: 0.72rem;
    color: var(--text-muted);
    margin-bottom: 2px;
  }

  .channel-value {
    font-size: 0.95rem;
    font-weight: 600;
    color: var(--text-primary);
    transition: color var(--transition-fast);
  }

  .channel-item:hover .channel-value {
    color: var(--accent-cyan);
  }

  .channel-arrow {
    color: var(--text-muted);
    transition: all var(--transition-fast);
    display: flex;
    align-items: center;
  }

  .channel-item:hover .channel-arrow {
    color: var(--accent-cyan);
    transform: translate(2px, -2px);
  }

  .copy-btn {
    background: transparent;
    border: none;
    color: var(--text-muted);
    cursor: pointer;
    padding: 0.4rem;
    border-radius: var(--radius-sm);
    display: flex;
    align-items: center;
    justify-content: center;
    position: relative;
    transition: color var(--transition-fast);
    z-index: 2;
  }

  .copy-btn:hover {
    color: var(--accent-cyan);
  }

  .copy-tooltip {
    position: absolute;
    bottom: 120%;
    right: 50%;
    transform: translateX(50%);
    background: #000;
    color: #fff;
    font-family: var(--font-mono);
    font-size: 0.7rem;
    padding: 0.2rem 0.5rem;
    border-radius: 4px;
    opacity: 0;
    pointer-events: none;
    transition: opacity 0.2s;
    white-space: nowrap;
  }

  .copy-tooltip.visible {
    opacity: 1;
  }

  .start-convo-btn {
    width: 100%;
    padding: 0.9rem;
    font-size: 1rem;
  }
</style>
